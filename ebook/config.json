{
  "base_url": "https://openrouter.ai/api/v1",
  "language": "ko",
  "pass_threshold": 8,
  "max_rounds": 3,
  "roles": {
    "researcher":        {"model": "openai/gpt-5.6-luna:online",      "max_tokens": 9000, "reasoning_effort": "medium"},
    "storyteller":       {"model": "google/gemini-3.8-flash",         "max_tokens": 8000, "reasoning_effort": "low"},
    "skeptic":           {"model": "x-ai/grok-4.6",                   "max_tokens": 7000, "reasoning_effort": "medium"},
    "fact_checker":      {"model": "deepseek/deepseek-v4-pro:online",  "max_tokens": 8000, "reasoning_effort": "medium"},
    "learning_scientist":{"model": "upstage/solar-pro4",              "max_tokens": 8000, "reasoning_effort": "medium"},
    "psychologist":      {"model": "z-ai/glm-5.3",                    "max_tokens": 7000, "reasoning_effort": "medium"},
    "reader_advocate":   {"model": "google/gemini-2.5-flash-lite",    "max_tokens": 4000},
    "chief_editor":      {"model": "anthropic/claude-sonnet-5",       "max_tokens": 12000, "reasoning_effort": "medium"}
  },
  "reviewers": ["skeptic", "fact_checker", "learning_scientist", "psychologist", "reader_advocate"]
}
